  "home.code.sample": {
    "message": "// 在 Canvas 节点上创建折线图\nvar chart = gameObject.AddComponent<LineChart>();\nchart.Init();\nchart.SetSize(580, 300);\n\nchart.AddXAxisData(\"周一\");\nchart.AddXAxisData(\"周二\");\nchart.AddXAxisData(\"周三\");\n\nchart.AddData(0, 120);\nchart.AddData(0, 200);\nchart.AddData(0, 150);"
  },
