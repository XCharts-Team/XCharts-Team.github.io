  "home.code.sample": {
    "message": "// Create a line chart on a Canvas object\nvar chart = gameObject.AddComponent<LineChart>();\nchart.Init();\nchart.SetSize(580, 300);\n\nchart.AddXAxisData(\"Mon\");\nchart.AddXAxisData(\"Tue\");\nchart.AddXAxisData(\"Wed\");\n\nchart.AddData(0, 120);\nchart.AddData(0, 200);\nchart.AddData(0, 150);"
  },
