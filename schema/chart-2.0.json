{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcharts-team.github.io/schema/chart-2.0.json",
  "title": "XCharts chart 2.0 document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://xcharts-team.github.io/schema/chart-2.0.json"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "chartType": {
      "type": "string"
    },
    "chartVersion": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "series/component entry",
        "properties": {
          "type": {
            "type": "string",
            "description": "简化类型名。"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "series/component entry",
        "properties": {
          "type": {
            "type": "string",
            "description": "简化类型名。"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "settings": {
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "chartType",
    "components",
    "series"
  ],
  "additionalProperties": true,
  "$defs": {
    "specColor": {
      "type": "object",
      "title": "linear RGBA color",
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "title": "shared theme definition",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "background": {
          "$ref": "#/$defs/specColor"
        },
        "contrast": {
          "$ref": "#/$defs/specColor"
        },
        "transparentBackground": {
          "type": "boolean"
        },
        "colorPalette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/specColor"
          }
        },
        "fontKey": {
          "type": "string"
        },
        "textureKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "component text style",
            "properties": {
              "id": {
                "type": "string"
              },
              "textColor": {
                "$ref": "#/$defs/specColor"
              },
              "textBackgroundColor": {
                "$ref": "#/$defs/specColor"
              },
              "fontSize": {
                "type": "integer"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "serie": {
          "type": "object",
          "title": "serie defaults",
          "properties": {
            "lineWidth": {
              "type": "number"
            },
            "lineSymbolSize": {
              "type": "number"
            },
            "scatterSymbolSize": {
              "type": "number"
            },
            "candlestickColor": {
              "$ref": "#/$defs/specColor"
            },
            "candlestickColor0": {
              "$ref": "#/$defs/specColor"
            },
            "candlestickBorderWidth": {
              "type": "number"
            },
            "candlestickBorderColor": {
              "$ref": "#/$defs/specColor"
            },
            "candlestickBorderColor0": {
              "$ref": "#/$defs/specColor"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
